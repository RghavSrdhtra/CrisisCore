// Prisma Schema for NexCommand
// RBAC-enabled Crisis Response Platform Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model with Multi-Tier Role Privilege
// Roles: CIVILIAN, RESPONDER, COORDINATOR, ADMIN, RESOURCE_MANAGER, INCIDENT_MANAGER
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CIVILIAN") // CIVILIAN | RESPONDER | COORDINATOR | ADMIN | RESOURCE_MANAGER | INCIDENT_MANAGER
  phone        String?
  agency       String?  // e.g. "Metro Fire Service", "Emergency Medical Corp", "Police Dept", "Logistics Command"
  badgeNumber  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  incidents            Incident[]
  responderProfile     Responder?
  auditLogs            AuditLog[]
  assignmentsCoordinated Assignment[] @relation("CoordinatorAssignments")
}

// Incident Model with ML Prioritization & Voluntary Location Lifecycle
model Incident {
  id                    String    @id @default(uuid())
  incidentNumber        String    @unique // e.g. "INC-2026-001"
  type                  String    // MEDICAL | FIRE | SECURITY | NATURAL_DISASTER | INDUSTRIAL | OTHER
  description           String
  affectedCount         Int       @default(1)
  status                String    @default("REPORTED") // REPORTED | TRIAGED | DISPATCHED | ON_SCENE | RESOLVED | CANCELLED
  severity              String    @default("MEDIUM")   // LOW | MEDIUM | HIGH | CRITICAL (initial/reported)
  
  // Predictive ML attributes (Section 4.2)
  predictedPriority     String?   // LOW | MEDIUM | HIGH | CRITICAL
  priorityConfidence    Float?    // 0.0 to 1.0 confidence score
  manualPriority        String?   // Coordinator/Admin override priority
  
  // Structured Resource Needs (Diagram 1 - Incident Manager)
  resourceNeeds         String?   // JSON-encoded object: e.g. {"water_litres": 200, "food_rations": 50, "medical_kits": 5, "ambulances": 1, "rescue_teams": 1}
  managerNotes          String?   // Incident manager verification notes
  
  // Geospatial & Privacy attributes (Section 4.1, 4.6, 4.11)
  lat                   Float
  lng                   Float
  address               String?
  locationSharingActive Boolean   @default(true) // Voluntary location toggle; terminates upon RESOLVED
  reporterContact       String?
  
  reporterId            String?
  reporter              User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  
  reportedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  resolvedAt            DateTime?

  // Relationships
  assignments           Assignment[]
  locationLogs          LocationLog[]
  chatMessages          ChatMessage[]
}

// Responder Model representing emergency units & field personnel
model Responder {
  id                String    @id @default(uuid())
  callsign          String    @unique // e.g. "MEDIC-01", "FIRE-ENGINE-02", "RESCUE-ALPHA"
  name              String
  type              String    // FIRE_RESCUE | MEDICAL_AMBULANCE | POLICE_SECURITY | DISASTER_PERSONNEL | SPECIALIZED_EQUIPMENT
  capability        String    // CSV or description of capabilities
  status            String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | EN_ROUTE | ON_SCENE | UNAVAILABLE
  lat               Float
  lng               Float
  currentIncidentId String?
  lastStatusUpdate  DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relationships
  resources         Resource[]
  assignments       Assignment[]
  locationLogs      LocationLog[]
}

// Physical inventory & relief supplies managed by Resource Manager (Diagram 1)
// Covers: Ambulances, rescue teams, food, water, medicine, equipment
model Resource {
  id                  String     @id @default(uuid())
  name                String     // e.g. "Clean Drinking Water", "Trauma First-Aid Kit", "Ambulance ALS Unit"
  category            String     @default("EQUIPMENT") // AMBULANCE | RESCUE_TEAM | FOOD | WATER | MEDICINE | EQUIPMENT
  type                String     // VEHICLE | CONSUMABLE | RELIEF_SUPPLY | KIT | TOOL
  status              String     @default("OPERATIONAL") // OPERATIONAL | IN_USE | LOW_STOCK | MAINTENANCE
  
  // Quantitative Inventory Tracking
  quantityTotal       Int        @default(1)
  quantityAvailable   Int        @default(1)
  quantityAllocated   Int        @default(0)
  unit                String     @default("UNITS") // LITRES | RATIONS | KITS | VEHICLES | PERSONNEL
  
  // Supply Depot / Staging Area Geolocation
  depotName           String?    @default("Central Logistics Depot")
  depotLat            Float?
  depotLng            Float?

  assignedResponderId String?
  assignedResponder   Responder? @relation(fields: [assignedResponderId], references: [id], onDelete: SetNull)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// Assignment & Mission Model linking Incidents, Responders, Stop Sequences & Admin Approvals
model Assignment {
  id                      String    @id @default(uuid())
  incidentId              String
  incident                Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responderId             String
  responder               Responder @relation(fields: [responderId], references: [id], onDelete: Cascade)
  status                  String    @default("RECOMMENDED") // RECOMMENDED | APPROVED | DISPATCHED | ACKNOWLEDGED | EN_ROUTE | ON_SCENE | COMPLETED | CANCELLED
  
  assignedByCoordinatorId String?
  assignedByCoordinator   User?     @relation("CoordinatorAssignments", fields: [assignedByCoordinatorId], references: [id], onDelete: SetNull)
  
  recommendationScore     Float?    // Output metric from Hungarian / ILP optimizer
  assignedAt              DateTime  @default(now())
  acknowledgedAt          DateTime?
  completedAt             DateTime?
  declineReason           String?   // Reason provided if respondent declines assignment
  notes                   String?

  // Human-in-the-Loop Admin Approval (Diagram 1, Step 5 & 6)
  adminApprovalStatus     String    @default("PENDING") // PENDING | APPROVED | REJECTED | MODIFIED
  approvedByAdminId       String?
  allocatedSupplies       String?   // JSON snapshot of supplies allocated: e.g. [{"resourceId": "...", "name": "Water", "qty": 50}]

  // Mission Details & Sequential Stop Progression (Diagram 1, Step 7)
  stopSequence            String?   // JSON array of stops: [{"stopNumber": 1, "type": "DEPOT_PICKUP", "name": "...", "lat": ..., "lng": ..., "status": "COMPLETED"}, ...]
  deliveryStatus          String    @default("PENDING") // PENDING | IN_TRANSIT | DELIVERED | VERIFIED
  deliveryConfirmedAt     DateTime?
  deliveryRecipient       String?
  deliveryNotes           String?

  // Dynamic Reallocation Triggers (Diagram 1, Step 8)
  reallocationTriggered   Boolean   @default(false)
  reallocationReason      String?
}

// Privacy-Aware Location Tracking Log (Subject to 48h Retention Policy - Section 4.11)
model LocationLog {
  id          String    @id @default(uuid())
  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responderId String?
  responder   Responder?@relation(fields: [responderId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  accuracy    Float?
  source      String    @default("GPS") // GPS | MANUAL | ESTIMATED
  timestamp   DateTime  @default(now())
  isActive    Boolean   @default(true)  // Flagged false on purge / incident closure
}

// Audit Trail for Security, Dispatch Overrides, and Privacy Verification
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // DISPATCH_OVERRIDE | STATUS_CHANGE | LOCATION_ACCESSED | USER_LOGIN | PRIVACY_PURGE | ADMIN_APPROVAL | REALLOCATION_TRIGGER
  resourceType String   // INCIDENT | ASSIGNMENT | RESPONDER | USER | RESOURCE
  resourceId   String?
  details      String?  // JSON context or description
  ipAddress    String?
  timestamp    DateTime @default(now())
}

// Real-Time Communication Messages across Admin 3-Channels and Civilian Line (Diagram 2)
model ChatMessage {
  id         String   @id @default(uuid())
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel    String   // "CHANNEL_1_RESOURCE" | "CHANNEL_2_INCIDENT" | "CHANNEL_3_RESPONDER" | "CIVILIAN" | "OPS"
  senderId   String?
  senderName String
  senderRole String   // "ADMIN" | "RESOURCE_MANAGER" | "INCIDENT_MANAGER" | "COORDINATOR" | "RESPONDER" | "CIVILIAN"
  message    String
  createdAt  DateTime @default(now())
}
